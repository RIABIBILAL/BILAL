<section class="page">
  <div class="page__inner container">
    <h1 class="page__title">{{ page.title }}</h1>
    <div class="page__content">{{ page.content }}</div>
  </div>
</section>

{% stylesheet %}
  .page {
    padding-block: var(--zinara-space-2xl);
  }

  .page__inner {
    max-width: 48rem;
    margin-inline: auto;
  }

  .page__title {
    margin-bottom: var(--zinara-space-lg);
    text-align: center;
  }

  .page__content {
    line-height: var(--zinara-leading-relaxed);
  }

  .page__content :last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
