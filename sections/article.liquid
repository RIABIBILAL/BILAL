<section class="article">
  <div class="article__inner container">
    <header class="article__header">
      <p class="article__date">{{ article.published_at | date: '%B %d, %Y' }}</p>
      <h1 class="article__title">{{ article.title }}</h1>
      {%- if article.author != blank -%}
        <p class="article__author">{{ 'article.by_author' | t: author: article.author }}</p>
      {%- endif -%}
    </header>

    {%- if article.image -%}
      <div class="article__media">
        {%- render 'responsive-image', image: article.image, sizes: '(min-width: 750px) 800px, 100vw', loading: 'eager', class: 'article__image' -%}
      </div>
    {%- endif -%}

    <div class="article__content">{{ article.content }}</div>
  </div>
</section>

{% stylesheet %}
  .article {
    padding-block: var(--zinara-space-2xl);
  }

  .article__inner {
    max-width: 48rem;
    margin-inline: auto;
  }

  .article__header {
    margin-bottom: var(--zinara-space-lg);
    text-align: center;
  }

  .article__date {
    margin: 0 0 var(--zinara-space-2xs);
    font-size: var(--zinara-text-xs);
    letter-spacing: var(--zinara-tracking-wide);
    text-transform: uppercase;
    opacity: 0.6;
  }

  .article__title {
    margin: 0 0 var(--zinara-space-2xs);
  }

  .article__author {
    margin: 0;
    font-size: var(--zinara-text-sm);
    opacity: 0.7;
  }

  .article__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    margin-bottom: var(--zinara-space-lg);
    background-color: var(--zinara-sand);
  }

  .article__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article__content {
    line-height: var(--zinara-leading-relaxed);
  }

  .article__content :last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
