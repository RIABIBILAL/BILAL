<section class="blog">
  <div class="blog__inner container">
    <h1 class="blog__title">{{ blog.title }}</h1>

    {%- paginate blog.articles by 12 -%}
      {%- if blog.articles.size > 0 -%}
        <div class="blog__grid">
          {%- for article in blog.articles -%}
            <article class="blog-card">
              <a href="{{ article.url }}" class="blog-card__media-link">
                <div class="blog-card__media">
                  {%- if article.image -%}
                    {%- render 'responsive-image', image: article.image, sizes: '(min-width: 750px) 33vw, 100vw', class: 'blog-card__image' -%}
                  {%- endif -%}
                </div>
              </a>
              <div class="blog-card__info">
                <p class="blog-card__date">{{ article.published_at | date: '%B %d, %Y' }}</p>
                <h2 class="blog-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
                {%- if article.excerpt != blank -%}
                  <p class="blog-card__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
        {%- render 'pagination', paginate: paginate -%}
      {%- else -%}
        <p class="blog__empty">{{ 'blog.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% stylesheet %}
  .blog {
    padding-block: var(--zinara-space-2xl);
  }

  .blog__title {
    margin-bottom: var(--zinara-space-lg);
    text-align: center;
  }

  .blog__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--zinara-space-lg);
  }

  .blog-card__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    margin-bottom: var(--zinara-space-sm);
    background-color: var(--zinara-sand);
  }

  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-card__date {
    margin: 0 0 var(--zinara-space-3xs);
    font-size: var(--zinara-text-xs);
    letter-spacing: var(--zinara-tracking-wide);
    text-transform: uppercase;
    opacity: 0.6;
  }

  .blog-card__title {
    margin: 0 0 var(--zinara-space-2xs);
    font-size: var(--zinara-text-md);
  }

  .blog-card__excerpt {
    margin: 0;
    color: var(--zinara-charcoal);
    line-height: var(--zinara-leading-relaxed);
  }

  .blog__empty {
    text-align: center;
  }

  @media (min-width: 750px) {
    .blog__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
