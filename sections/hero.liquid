{%- liquid
  assign content_position = section.settings.content_position | default: 'center'
  assign overlay_opacity = section.settings.overlay_opacity | default: 20 | divided_by: 100.0
  assign min_height = section.settings.min_height | default: 640
-%}
<section
  class="hero hero--content-{{ content_position }}{% if section.settings.image %} hero--has-image{% endif %}"
  style="--zinara-hero-min-height: {{ min_height }}px; --zinara-hero-overlay: {{ overlay_opacity }};"
>
  {%- if section.settings.image -%}
    <div class="hero__media">
      {%- render 'responsive-image', image: section.settings.image, sizes: '100vw', loading: 'eager', class: 'hero__image' -%}
      <div class="hero__overlay" aria-hidden="true"></div>
    </div>
  {%- endif -%}

  <div class="hero__content container" data-animate>
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          {%- render 'button', label: section.settings.button_label, url: section.settings.button_link, style: 'primary' -%}
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          {%- render 'button', label: section.settings.button_label_2, url: section.settings.button_link_2, style: 'secondary' -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* Static, restrained layout only — no entrance animation. A cinematic
     hero reveal is an explicit Phase 7 deliverable, built on top of this,
     never instead of it. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--zinara-hero-min-height, 480px);
    overflow: hidden;
    background-color: var(--zinara-sand);
    color: var(--zinara-charcoal);
  }

  .hero--has-image {
    color: var(--zinara-ivory);
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Slight static overscale so the subtle scroll parallax theme.js adds
       (desktop pointer devices, motion allowed) never reveals an edge. */
    transform: scale(1.04);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--zinara-charcoal);
    opacity: var(--zinara-hero-overlay, 0.2);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--zinara-space-sm);
    padding-block: var(--zinara-space-2xl);
  }

  .hero--content-left .hero__content {
    align-items: flex-start;
    text-align: left;
  }

  .hero--content-center .hero__content {
    align-items: center;
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
  }

  .hero--content-right .hero__content {
    align-items: flex-end;
    text-align: right;
    margin-inline-start: auto;
  }

  .hero__eyebrow {
    color: inherit;
    opacity: 0.85;
  }

  .hero__heading {
    margin: 0;
    max-width: 20ch;
    color: inherit;
  }

  .hero__text {
    margin: 0;
    max-width: 40ch;
    font-size: var(--zinara-text-md);
    line-height: var(--zinara-leading-relaxed);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--zinara-space-sm);
    margin-top: var(--zinara-space-sm);
  }

  .hero--content-center .hero__actions {
    justify-content: center;
  }

  .hero--content-right .hero__actions {
    justify-content: flex-end;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quiet luxury, deliberately made"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subheading",
      "default": "Considered jewelry for everyday radiance."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 640
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
