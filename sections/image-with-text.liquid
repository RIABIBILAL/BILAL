{%- liquid
  assign layout = section.settings.layout | default: 'image_text'
-%}
{%- if layout == 'statement' -%}
  <section class="image-with-text image-with-text--statement">
    <div class="image-with-text__statement container" data-animate>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <span class="accent-rule" aria-hidden="true"></span>
      {%- if section.settings.heading != blank -%}
        <h2 class="image-with-text__statement-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="image-with-text__statement-body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        {%- render 'button', label: section.settings.button_label, url: section.settings.button_link, style: 'ghost' -%}
      {%- endif -%}
    </div>
  </section>
{%- else -%}
  <section class="image-with-text image-with-text--image-{{ section.settings.image_position | default: 'right' }}">
    <div class="image-with-text__inner container">
      {%- if section.settings.image -%}
        <div class="image-with-text__media">
          {%- render 'responsive-image', image: section.settings.image, sizes: '(min-width: 750px) 50vw, 100vw', class: 'image-with-text__image' -%}
        </div>
      {%- endif -%}
      <div class="image-with-text__content" data-animate>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="image-with-text__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="image-with-text__body">{{ section.settings.body }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          {%- render 'button', label: section.settings.button_label, url: section.settings.button_link, style: 'secondary' -%}
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .image-with-text {
    padding-block: var(--zinara-space-3xl);
  }

  .image-with-text__inner {
    display: grid;
    gap: var(--zinara-space-lg);
    align-items: start;
  }

  .image-with-text__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--zinara-sand);
  }

  .image-with-text__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-with-text__heading {
    margin: 0 0 var(--zinara-space-sm);
  }

  .image-with-text__body {
    margin-bottom: var(--zinara-space-md);
    color: var(--zinara-charcoal);
    line-height: var(--zinara-leading-relaxed);
  }

  .image-with-text__body :last-child {
    margin-bottom: 0;
  }

  @media (min-width: 750px) {
    .image-with-text__inner {
      /* Asymmetric split, image column wider — matches the craftsmanship
         section's editorial proportions rather than a plain 50/50.
         Explicit grid-column placement (not `order`) — the markup always
         renders media before content, so a same-relative-order `order`
         pair here would silently do nothing. Default is image_position:
         right, so the image sits in the wider, second column. */
      grid-template-columns: 5fr 7fr;
      gap: var(--zinara-space-2xl);
    }

    .image-with-text__media {
      grid-column: 2;
    }

    .image-with-text__content {
      grid-column: 1;
      margin-top: var(--zinara-space-2xl);
    }

    .image-with-text--image-left .image-with-text__inner {
      grid-template-columns: 7fr 5fr;
    }

    .image-with-text--image-left .image-with-text__media {
      grid-column: 1;
    }

    .image-with-text--image-left .image-with-text__content {
      grid-column: 2;
    }
  }

  /* A soft-sand band — a deliberate tonal pause between the surrounding
     ivory sections, using an existing token rather than a new color. */
  .image-with-text--statement {
    background-color: var(--zinara-sand);
  }

  .image-with-text__statement {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  /* The shared .eyebrow/.accent-rule gold tones are verified against
     ivory (contrast checked in Phase 2/11A) but fall short against this
     section's sand background — gold-dark on sand is ~3.4:1 (fails AA
     text), raw gold on sand is ~2:1 (barely visible). Charcoal keeps the
     line/label legible and still reads as a deliberate accent; the gold
     motif already appears in the hero, craftsmanship and newsletter
     sections on this page. */
  .image-with-text__statement .eyebrow {
    color: var(--zinara-charcoal);
  }

  .image-with-text__statement .accent-rule {
    margin-inline: auto;
    background-color: var(--zinara-charcoal);
  }

  /* Same reasoning: the ghost button's default gold-dark hover would also
     fall below AA here, so the hover cue is the underline disappearing
     instead of a color change (still fully accessible, never relies on
     color alone). */
  .image-with-text__statement .button--ghost:hover,
  .image-with-text__statement .button--ghost:focus-visible {
    color: var(--zinara-charcoal);
    text-decoration: none;
  }

  .image-with-text__statement-heading {
    margin: 0 0 var(--zinara-space-md);
    font-size: calc(var(--zinara-text-3xl) * var(--zinara-type-heading-scale));
  }

  .image-with-text__statement-body {
    color: var(--zinara-charcoal);
    font-size: var(--zinara-text-md);
    line-height: var(--zinara-leading-relaxed);
    margin-bottom: var(--zinara-space-md);
  }

  .image-with-text__statement-body :last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image_text", "label": "Image with text" },
        { "value": "statement", "label": "Statement (text only)" }
      ],
      "default": "image_text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Used when layout is Image with text."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "An editorial moment"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
