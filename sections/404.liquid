<section class="error-404">
  <div class="error-404__inner container">
    <p class="eyebrow">404</p>
    <h1 class="error-404__title">{{ 'error_404.title' | t }}</h1>
    <p class="error-404__text">{{ 'error_404.text' | t }}</p>
    {%- assign error_404_button_label = 'error_404.button' | t -%}
    {%- render 'button', label: error_404_button_label, url: routes.root_url, style: 'primary' -%}
  </div>
</section>

{% stylesheet %}
  .error-404 {
    padding-block: var(--zinara-space-3xl);
  }

  .error-404__inner {
    max-width: 32rem;
    margin-inline: auto;
    text-align: center;
  }

  .error-404__title {
    margin: var(--zinara-space-2xs) 0 var(--zinara-space-sm);
  }

  .error-404__text {
    margin: 0 0 var(--zinara-space-lg);
    color: var(--zinara-charcoal);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404",
  "settings": []
}
{% endschema %}
