{%- liquid
  assign layout = section.settings.layout | default: 'products'
-%}
<section class="featured-collection">
  <div class="featured-collection__inner container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="featured-collection__header" data-animate>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if layout == 'products' -%}
      {%- liquid
        assign display_collection = section.settings.collection
        assign products_to_show = section.settings.products_to_show | default: 4
      -%}
      <div class="featured-collection__grid">
        {%- if display_collection != blank and display_collection.products.size > 0 -%}
          {%- for product in display_collection.products limit: products_to_show -%}
            {%- render 'product-card', card_product: product -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..products_to_show) -%}
            <div class="product-card product-card--placeholder">
              <div class="product-card__media">
                {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__image--primary' }}
              </div>
              <div class="product-card__info">
                <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="featured-collection__categories">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_collection = block.settings.collection
            assign tile_title = block.settings.title_override
            if tile_title == blank
              assign tile_title = block_collection.title
            endif
          -%}
          <a
            href="{{ block_collection.url | default: '#' }}"
            class="category-tile"
            {{ block.shopify_attributes }}
          >
            <div class="category-tile__media">
              {%- if block_collection.featured_image -%}
                {%- render 'responsive-image',
                  image: block_collection.featured_image,
                  sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 100vw',
                  class: 'category-tile__image'
                -%}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'category-tile__image' }}
              {%- endif -%}
            </div>
            <p class="category-tile__title">
              {%- if tile_title != blank -%}
                {{ tile_title }}
              {%- else -%}
                {{ 'onboarding.collection_title' | t }}
              {%- endif -%}
            </p>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="featured-collection__footer">
        {%- render 'button', label: section.settings.button_label, url: section.settings.button_link, style: 'secondary' -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .featured-collection {
    padding-block: var(--zinara-space-3xl);
  }

  .featured-collection__header {
    margin-bottom: var(--zinara-space-lg);
    text-align: center;
  }

  .featured-collection__grid,
  .featured-collection__categories {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--zinara-space-md);
  }

  .featured-collection__footer {
    margin-top: var(--zinara-space-lg);
    text-align: center;
  }

  @media (min-width: 750px) {
    .featured-collection__grid,
    .featured-collection__categories {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--zinara-space-lg);
    }
  }

  @media (min-width: 990px) {
    .featured-collection__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "products", "label": "Product grid" },
        { "value": "categories", "label": "Category grid" }
      ],
      "default": "products"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when layout is Product grid."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "info": "Used when layout is Product grid."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "\"View all\" label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "\"View all\" link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Title override",
          "info": "Defaults to the collection's title."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collection",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
